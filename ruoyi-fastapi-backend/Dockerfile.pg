FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=Asia/Shanghai
WORKDIR /app
# psycopg2 需要编译工具、C 标准头文件和 libpq，字体供验证码使用。
ARG DEBIAN_MIRROR=https://deb.debian.org
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 install -y --no-install-recommends gcc libc6-dev libpq-dev fonts-dejavu-core fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-pg.txt /tmp/requirements-pg.txt
# 公共依赖单独缓存，业务代码变更不重复下载；本项目CLI在复制代码后安装。
RUN tr -d '\r' < /tmp/requirements-pg.txt | sed '/^\.$/d' > /tmp/runtime-requirements.txt \
    && pip install --no-cache-dir --timeout 60 --retries 2 -i "$PIP_INDEX_URL" -r /tmp/runtime-requirements.txt
COPY . .
RUN pip install --no-cache-dir --no-deps .
EXPOSE 9099
ENTRYPOINT ["python", "scripts/feedback_container.py"]
CMD ["serve"]
