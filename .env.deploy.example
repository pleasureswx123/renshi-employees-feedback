# 复制为 .env.deploy 后填写真实地址；本文件不存放密码。
FEEDBACK_APP_URL=
WEB_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=12580
FEEDBACK_PORT=12581
POSTGRES_DB=ruoyi_feedback_prod
FEEDBACK_SECRETS_DIR=./deploy/secrets
APP_WORKERS=1
RELEASE_TAG=local
# 按部署网络选用；空前缀表示 Docker Hub 官方镜像。
IMAGE_PREFIX=
DEBIAN_MIRROR=https://deb.debian.org
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
